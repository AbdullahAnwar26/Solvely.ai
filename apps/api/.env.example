DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Number of trusted reverse proxies in front of the API (used for per-IP throttling).
DJANGO_NUM_PROXIES=0
# DATABASE_URL=postgres://user:password@localhost:5432/tutor
# --- AI provider (Story 3.1) ---
# Which adapter serves AI calls: `gemini` (default) or `fake` (deterministic, offline; tests
# always use `fake`).
AI_PROVIDER=gemini
# Server-side only; never commit a real key. Without it (or without GEMINI_MODEL) every AI call
# fails with `provider_unavailable`; there is no fallback answer and no default model.
GEMINI_API_KEY=
# Gemini model id, required. There is deliberately no default in code.
# Verified 2026-10-29 at https://ai.google.dev/gemini-api/docs/models (page dated 2026-10-28):
# `gemini-3.8-flash` is a current stable Flash-class model.
# Model availability, quotas, rate limits and pricing are set by Google and change over time:
# re-check them in the official docs and AI Studio before every deployment.
GEMINI_MODEL=
# Base URL of the web app; password reset links are {FRONTEND_BASE_URL}/reset-password?uid=..&token=..
FRONTEND_BASE_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@localhost
# SMTP settings, used only when DJANGO_DEBUG=false (DEBUG prints emails to the console).
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
