DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Number of trusted reverse proxies in front of the API (used for per-IP throttling).
DJANGO_NUM_PROXIES=0
# DATABASE_URL=postgres://user:password@localhost:5432/tutor
GEMINI_API_KEY=
GEMINI_MODEL=
# Base URL of the web app; password reset links are {FRONTEND_BASE_URL}/reset-password?uid=..&token=..
FRONTEND_BASE_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@localhost
# SMTP settings, used only when DJANGO_DEBUG=false (DEBUG prints emails to the console).
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
